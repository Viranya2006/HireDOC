PORT=5000
API_BASE_URL=http://localhost:5000

# Comma-separated browser origins allowed to call this API (CORS)
# Defaults include localhost + https://hire-doc.vercel.app if unset
# CORS_ORIGINS=http://localhost:3000,https://hire-doc.vercel.app

# Local MongoDB (default if unset)
MONGODB_URI=mongodb://127.0.0.1:27017/hiredoc

# Optional: MongoDB Atlas (production)
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/hiredoc?retryWrites=true&w=majority

JWT_SECRET=your_jwt_secret_min_32_chars_change_me

# Firebase Admin — paste service account JSON on one line (Project settings → Service accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Local CV storage directory (default: ./uploads)
# UPLOADS_DIR=./uploads

# Optional — required only for AI screening / JD analysis
# Pay-as-you-go: API Keys at platform.minimax.io (needs MINIMAX_GROUP_ID from same page)
# Token Plan: Billing → Token Plan key (sk-cp-…); MINIMAX_GROUP_ID not required
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_GROUP_ID=your_minimax_group_id
# MINIMAX_API_BASE_URL=https://api.minimax.io/v1
# MINIMAX_MODEL=MiniMax-M2.7

# Gmail SMTP — candidate shortlist/rejection emails (use a Google App Password, not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=HireDoc <your.email@gmail.com>
